---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Naychur Rahl" description="The page you were looking for doesn't exist.">
  <section class="cta-section">
    <div class="container cta">
      <p class="eyebrow">404</p>
      <h2>This page doesn't exist.</h2>
      <p>It may have moved, or the link may be wrong. Try one of these instead.</p>
      <p class="detail-cta">
        <a class="button light" href="/">Go home</a>
        <a class="button secondary" href="/portfolio/">See our work</a>
      </p>
    </div>
  </section>
</BaseLayout>
